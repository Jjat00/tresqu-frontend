---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { heroCopy } from '../../../src/i18n/copy/hero';
import { splitHeading } from '../lib/splitHeading';

export async function getStaticPaths() {
  return (await getCollection('solutions')).map((page) => ({
    params: { solution: page.id }, props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const { title, heading, description, intro, updatedDate, faqs } = page.data;
const path = `/${page.id}/`;
const headline = splitHeading(heading);
const url = new URL(path, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'WebPage',
    '@id': `${url}#webpage`, url, name: heading, description, inLanguage: 'es',
    dateModified: updatedDate.toISOString(),
    publisher: { '@id': 'https://tresqu.com/#organization' },
    author: { '@type': 'Organization', '@id': 'https://tresqu.com/sobre-tresqu/#equipo', name: 'Equipo Tresqu', url: 'https://tresqu.com/sobre-tresqu/#equipo' },
    about: { '@type': 'SoftwareApplication', '@id': 'https://tresqu.com/#application', name: 'Tresqu', url: 'https://tresqu.com/', applicationCategory: 'FinanceApplication', operatingSystem: 'Web, WhatsApp, Telegram' },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://tresqu.com/' },
      { '@type': 'ListItem', position: 2, name: heading, item: url },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <article>
    <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a> › {title}</nav>
    <header class="solution-hero">
      <p class="eyebrow">TRESQU / TU DINERO, CONECTADO</p>
      <h1>{headline.a}{headline.b && <span class="accent">{headline.b}</span>}</h1>
      <p class="intro">{intro}</p>
      <div class="ctas">
        <a class="btn start-link" href={heroCopy.es.whatsappUrl}>Empezar en WhatsApp</a>
        <a class="btn-ghost secondary-link" href="/login">Entrar a la web</a>
      </div>
      <p class="byline">Por <a href="/sobre-tresqu/#equipo">Equipo Tresqu</a> · Actualizado el <time datetime={updatedDate.toISOString()}>{new Intl.DateTimeFormat('es', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(updatedDate)}</time></p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <section class="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">Preguntas frecuentes</h2>
      {faqs.map(({ q, a }) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </section>
    <aside class="closing">
      <h2>Empieza por una conversación</h2>
      <p>Registra tu primer movimiento y pregunta por tu dinero. Puedes añadir Gmail y Wallbit desde tu perfil cuando los necesites.</p>
      <a class="btn start-link" href={heroCopy.es.whatsappUrl}>Abrir Tresqu en WhatsApp</a>
      <p class="closing-links"><a href="/funciones">Ver todas las funciones</a> · <a href="/privacy-policy">Consultar privacidad</a></p>
    </aside>
  </article>
</BaseLayout>

<style>
  .solution-hero {
    padding: 28px 0 32px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }

  .solution-hero h1 { font-size: clamp(36px, 5vw, 58px); }

  .intro { color: #dfe3f2; font-size: clamp(17px, 1.5vw, 19px); line-height: 1.7; }

  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin: 28px 0 0; }

  .start-link, .start-link:hover { color: #000; }
  .secondary-link, .secondary-link:hover { color: #fff; }

  .byline { margin: 24px 0 0; }

  .prose > :global(h2:first-child) { margin-top: 0; }

  .faq { margin-top: 56px; }

  .closing {
    margin-top: 56px;
    padding: 40px 28px 32px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 22px;
    background: radial-gradient(120% 90% at 50% 0%, rgba(0, 255, 127, 0.16), transparent 62%), #06100d;
    text-align: center;
  }

  .closing h2 { margin: 0 0 12px; font-weight: 300; font-size: clamp(28px, 3.4vw, 40px); letter-spacing: -0.035em; }

  .closing p { max-width: 520px; margin: 0 auto 24px; }

  .closing .closing-links { margin: 22px auto 0; color: var(--muted); font-size: 14px; }

  @media (max-width: 480px) {
    .ctas { flex-direction: column; align-items: stretch; }
    .closing { padding: 32px 20px 26px; }
    .closing .btn { width: 100%; }
  }
</style>
