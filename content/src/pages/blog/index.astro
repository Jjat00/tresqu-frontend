---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = new Intl.DateTimeFormat('es', { day: 'numeric', month: 'long', year: 'numeric' });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog de Tresqu',
    url: new URL('/blog/', Astro.site).href,
    description:
      'Guías y comparativas sobre finanzas personales con IA: registrar gastos por chat, entender tus ingresos e invertir con contexto.',
    publisher: { '@type': 'Organization', name: 'Tresqu', url: 'https://tresqu.com' },
  },
];
---

<BaseLayout
  title="Blog — finanzas personales con IA"
  description="Guías y comparativas sobre finanzas personales con IA: registrar gastos por chat, entender tus ingresos e invertir con contexto."
  path="/blog/"
  jsonLd={jsonLd}
>
  <header class="blog-hero">
    <p class="eyebrow">Guías de Tresqu</p>
    <h1>Blog <span class="accent">de Tresqu</span></h1>
    <p class="lede">
      Guías prácticas sobre finanzas personales con IA: cómo registrar tus gastos sin formularios,
      entender en qué se te va el dinero e invertir con tu contexto real.
    </p>
  </header>

  <section class="post-list">
    {posts.map((post) => (
      <a class="post-card" href={`/blog/${post.id}/`}>
        <time datetime={post.data.pubDate.toISOString()}>
          {fmt.format(post.data.updatedDate ?? post.data.pubDate)}
        </time>
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
        <span class="read-more" aria-hidden="true">Leer guía →</span>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .blog-hero { padding-bottom: 8px; }

  .blog-hero h1 { font-size: clamp(44px, 6.4vw, 76px); }

  .lede {
    max-width: 600px;
    color: var(--muted);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.65;
  }

  .post-list {
    display: grid;
    gap: 18px;
    margin-top: 48px;
  }

  .post-card {
    position: relative;
    display: block;
    padding: 28px 28px 26px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 18px;
    background: radial-gradient(120% 90% at 50% 0%, rgba(0, 255, 127, 0.14), transparent 62%), #06100d;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s ease;
  }

  .post-card:hover { border-color: rgba(0, 255, 127, 0.35); transform: translateY(-2px); color: inherit; }

  .post-card time {
    color: var(--green);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .post-card h2 {
    margin: 12px 0 10px;
    color: #fff;
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .post-card p { margin: 0 0 18px; color: var(--muted); font-size: 15.5px; line-height: 1.65; }

  .read-more { color: #fff; font-size: 14px; font-weight: 600; }

  @media (prefers-reduced-motion: reduce) {
    .post-card { transition: none; }
  }
</style>
