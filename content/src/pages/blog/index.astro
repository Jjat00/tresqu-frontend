---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = new Intl.DateTimeFormat('es', { day: 'numeric', month: 'long', year: 'numeric' });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog de Tresqu',
    url: new URL('/blog/', Astro.site).href,
    description:
      'Guías y comparativas sobre finanzas personales con IA: registrar gastos por chat, entender tus ingresos e invertir con contexto.',
    publisher: { '@type': 'Organization', name: 'Tresqu', url: 'https://tresqu.com' },
  },
];
---

<BaseLayout
  title="Blog — finanzas personales con IA"
  description="Guías y comparativas sobre finanzas personales con IA: registrar gastos por chat, entender tus ingresos e invertir con contexto."
  path="/blog/"
  jsonLd={jsonLd}
>
  <h1>Blog de Tresqu</h1>
  <p class="lede">
    Guías prácticas sobre finanzas personales con IA: cómo registrar tus gastos sin formularios,
    entender en qué se te va el dinero e invertir con tu contexto real.
  </p>

  <section class="post-list">
    {posts.map((post) => (
      <a class="post-card" href={`/blog/${post.id}/`}>
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
        <time datetime={post.data.pubDate.toISOString()}>
          {fmt.format(post.data.updatedDate ?? post.data.pubDate)}
        </time>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .lede {
    font-size: 1.1rem;
    color: hsl(0 0% 75%);
  }

  .post-list {
    display: grid;
    gap: 16px;
    margin-top: 32px;
  }

  .post-card {
    display: block;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 24px;
    text-decoration: none;
    transition: border-color 150ms ease;
  }

  .post-card:hover {
    border-color: var(--accent);
  }

  .post-card h2 {
    margin: 0 0 6px;
    font-size: 1.2rem;
    color: var(--fg);
  }

  .post-card p {
    margin: 0 0 10px;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .post-card time {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }
</style>
