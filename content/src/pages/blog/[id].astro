---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const path = `/blog/${post.id}/`;
const url = new URL(path, Astro.site).href;
const fmt = new Intl.DateTimeFormat('es', { day: 'numeric', month: 'long', year: 'numeric' });

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    url,
    mainEntityOfPage: url,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    inLanguage: 'es',
    author: { '@type': 'Organization', name: post.data.author, url: 'https://tresqu.com' },
    publisher: { '@type': 'Organization', name: 'Tresqu', url: 'https://tresqu.com' },
    image: new URL('/og-image.png', Astro.site).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://tresqu.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];

if (post.data.faqs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: post.data.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  });
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={path}
  ogType="article"
  jsonLd={jsonLd}
>
  <article>
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="https://tresqu.com/">Inicio</a> › <a href="/blog/">Blog</a>
    </nav>

    <h1>{post.data.title}</h1>

    <p class="byline">
      Por {post.data.author} ·
      <time datetime={post.data.pubDate.toISOString()}>
        Publicado el {fmt.format(post.data.pubDate)}
      </time>
      {post.data.updatedDate && (
        <>
          {' · '}
          <time datetime={post.data.updatedDate.toISOString()}>
            Actualizado el {fmt.format(post.data.updatedDate)}
          </time>
        </>
      )}
    </p>

    <Content />

    {post.data.faqs.length > 0 && (
      <section class="faq">
        <h2>Preguntas frecuentes</h2>
        {post.data.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </section>
    )}

    <aside class="cta-box">
      <p>
        <strong>Tresqu</strong> es un equipo de agentes financieros con los que hablas por chat:
        registra tus gastos, entiende tus ingresos y usa tu contexto real para invertir contigo.
      </p>
      <a href="https://tresqu.com/" class="cta-link">Conocer Tresqu →</a>
    </aside>
  </article>
</BaseLayout>

<style>
  .breadcrumbs {
    font-size: 13px;
    font-family: var(--font-mono);
    color: var(--muted);
  }

  .breadcrumbs a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--fg);
  }

  .byline {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 2em;
  }

  .faq details {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px 18px;
    margin-bottom: 10px;
  }

  .faq summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--fg);
  }

  .faq details p {
    margin: 10px 0 0;
  }

  .cta-box {
    margin-top: 3em;
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 12px;
    padding: 20px 24px;
  }

  .cta-link {
    font-weight: 700;
    text-decoration: none;
  }
</style>
