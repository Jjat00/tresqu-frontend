---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { splitHeading } from '../../lib/splitHeading';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const path = `/blog/${post.id}/`;
const url = new URL(path, Astro.site).href;
const headline = splitHeading(post.data.title);
const fmt = new Intl.DateTimeFormat('es', { day: 'numeric', month: 'long', year: 'numeric' });

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    url,
    mainEntityOfPage: url,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    inLanguage: 'es',
    author: { '@type': 'Organization', name: post.data.author, url: 'https://tresqu.com/sobre-tresqu/#equipo' },
    publisher: { '@id': 'https://tresqu.com/#organization' },
    image: new URL('/og-image.png', Astro.site).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://tresqu.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];

if (post.data.faqs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: post.data.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  });
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={path}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="post">
    <header class="post-hero">
      <nav class="breadcrumbs" aria-label="Ruta de navegación">
        <a href="https://tresqu.com/">Inicio</a> › <a href="/blog/">Blog</a>
      </nav>

      <h1>{headline.a}{headline.b && <span class="accent">{headline.b}</span>}</h1>

      <p class="byline">
        Por <a href="/sobre-tresqu/#equipo">{post.data.author}</a> ·
        <time datetime={post.data.pubDate.toISOString()}>
          Publicado el {fmt.format(post.data.pubDate)}
        </time>
        {post.data.updatedDate && (
          <>
            {' · '}
            <time datetime={post.data.updatedDate.toISOString()}>
              Actualizado el {fmt.format(post.data.updatedDate)}
            </time>
          </>
        )}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {post.data.faqs.length > 0 && (
      <section class="faq">
        <h2>Preguntas frecuentes</h2>
        {post.data.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </section>
    )}

    <aside class="cta-box">
      <p>
        <strong>Tresqu</strong> es un equipo de agentes financieros con los que hablas por chat:
        registra tus gastos, entiende tus ingresos y usa tu contexto real para invertir contigo.
      </p>
      <a href="https://tresqu.com/" class="btn">Conocer Tresqu →</a>
    </aside>
  </article>
</BaseLayout>

<style>
  .post-hero {
    padding-bottom: 28px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }

  .post-hero h1 { font-size: clamp(34px, 4.8vw, 54px); margin-top: 22px; }

  .byline { margin: 0; }

  /* el primer h2 del artículo no necesita tanto aire arriba */
  .prose > :global(h2:first-child) { margin-top: 0; }

  .prose > :global(p:first-child) { color: #dfe3f2; font-size: 1.08em; }

  .faq { margin-top: 56px; }

  .cta-box {
    margin-top: 56px;
    padding: 30px 28px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 20px;
    background: radial-gradient(120% 90% at 50% 0%, rgba(0, 255, 127, 0.16), transparent 62%), #06100d;
  }

  .cta-box p { margin: 0 0 20px; font-size: 17px; }

  .cta-box .btn { color: #000; }
</style>
