---
import solutionLinks from '../../../src/lib/solutionLinks.json';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica absoluta desde la raíz, p. ej. "/blog/mi-post/" */
  path: string;
  ogType?: 'website' | 'article';
  /** JSON-LD adicional (BlogPosting, FAQPage…) ya serializable */
  jsonLd?: object[];
}

const { title, description, path, ogType = 'website', jsonLd = [] } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const organization = {
  '@context': 'https://schema.org', '@type': 'Organization',
  '@id': 'https://tresqu.com/#organization', name: 'Tresqu',
  url: 'https://tresqu.com/', logo: 'https://tresqu.com/3q.png',
  email: 'contacto@tresqu.com',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Tresqu</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content="Tresqu" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_LA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {[organization, ...jsonLd].map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block).replace(/</g, '\\u003c')} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=Syne:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a href="https://tresqu.com/" class="brand" aria-label="Ir al inicio de Tresqu">
        <img src="/3q.png" alt="" height="26" />
        <span>Tresqu</span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="/blog/">Blog</a>
        <a href="/funciones">Funciones</a>
        <a href="https://tresqu.com/" class="cta">Abrir Tresqu</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <nav class="solution-links" aria-label="Explora Tresqu">
        {solutionLinks.map(({ path: href, label }) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
      </nav>
      <p>© {new Date().getFullYear()} Tresqu · Finanzas e inversiones por chat.</p>
      <nav aria-label="Enlaces legales">
        <a href="https://tresqu.com/">tresqu.com</a>
        <a href="/funciones">Funciones</a>
        <a href="/privacy-policy">Privacidad</a>
        <a href="/sobre-tresqu/">Sobre Tresqu</a>
        <a href="mailto:contacto@tresqu.com">Contacto</a>
        <a href="/legal-notice">Aviso legal</a>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: hsl(0 0% 4%);
    --fg: hsl(0 0% 98%);
    --muted: hsl(0 0% 63%);
    --card: hsl(0 0% 7%);
    --border: hsl(0 0% 14%);
    --accent: #00ff7f;
    --font-sans: 'DM Sans', sans-serif;
    --font-display: 'Syne', sans-serif;
    --font-mono: 'Space Grotesk', monospace;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 24px;
  }

  .site-header .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--fg);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .site-header .brand img {
    display: block;
    border-radius: 6px;
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .site-header nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
  }

  .site-header nav a:hover {
    color: var(--fg);
  }

  .site-header nav a.cta {
    color: #000;
    background: var(--accent);
    padding: 8px 16px;
    border-radius: 999px;
    font-weight: 700;
  }

  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 24px 24px 64px;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    font-weight: 800;
    margin: 16px 0 8px;
  }

  h2 {
    font-size: 1.45rem;
    font-weight: 700;
    margin-top: 2.2em;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 700;
  }

  a {
    color: var(--accent);
  }

  p,
  li {
    color: hsl(0 0% 85%);
  }

  strong {
    color: var(--fg);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.4em 0;
    font-size: 0.95rem;
  }

  th,
  td {
    border: 1px solid var(--border);
    padding: 10px 12px;
    text-align: left;
    vertical-align: top;
  }

  th {
    background: var(--card);
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--fg);
  }

  code {
    font-family: var(--font-mono);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 0.9em;
  }

  blockquote {
    margin: 1.4em 0;
    padding: 4px 20px;
    border-left: 3px solid var(--accent);
    background: var(--card);
    border-radius: 0 8px 8px 0;
  }

  hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5em 0;
  }

  .site-footer {
    max-width: 1080px;
    margin: 0 auto;
    padding: 24px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
    justify-content: space-between;
    color: var(--muted);
    font-size: 14px;
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .site-footer .solution-links { width: 100%; padding-bottom: 16px; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 480px) {
    .site-header { flex-wrap: wrap; }
    .site-header nav { flex-wrap: wrap; gap: 12px; }
    table { display: block; overflow-x: auto; }
  }

  .site-footer a {
    color: var(--muted);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--fg);
  }
</style>
