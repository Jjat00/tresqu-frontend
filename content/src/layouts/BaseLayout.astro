---
import solutionLinks from '../../../src/lib/solutionLinks.json';
import { heroCopy } from '../../../src/i18n/copy/hero';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica absoluta desde la raíz, p. ej. "/blog/mi-post/" */
  path: string;
  ogType?: 'website' | 'article';
  /** JSON-LD adicional (BlogPosting, FAQPage…) ya serializable */
  jsonLd?: object[];
}

const { title, description, path, ogType = 'website', jsonLd = [] } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const organization = {
  '@context': 'https://schema.org', '@type': 'Organization',
  '@id': 'https://tresqu.com/#organization', name: 'Tresqu',
  url: 'https://tresqu.com/', logo: 'https://tresqu.com/3q.png',
  email: 'contacto@tresqu.com',
};
const whatsappUrl = heroCopy.es.whatsappUrl;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Tresqu</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content="Tresqu" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_LA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {[organization, ...jsonLd].map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block).replace(/</g, '\\u003c')} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Campo de puntos de la landing, en CSS puro (sin JS) -->
    <div class="dot-field" aria-hidden="true">
      <span class="dots dots-dim"></span>
      <span class="dots dots-bright"></span>
    </div>

    <header class="site-header">
      <nav class="pill" aria-label="Navegación principal">
        <a href="https://tresqu.com/" class="brand" aria-label="Ir al inicio de Tresqu">
          <img src="/3q.png" alt="" width="24" height="24" />
          <span>Tresqu</span>
        </a>
        <a href="/blog/" class="nav-link" aria-current={path.startsWith('/blog/') ? 'page' : undefined}>Blog</a>
        <a href="/funciones" class="nav-link">Funciones</a>
        <a href={whatsappUrl} class="nav-wa">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2a9.8 9.8 0 0 0-8.4 14.8L2.2 21.8l4.9-1.3A9.8 9.8 0 1 0 12 2.2zm0 17.8a8 8 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1 1 12 20zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6c.1.2 1.7 2.6 4.1 3.6 1.5.7 2.1.7 2.9.6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.2-.2z"/></svg>
          <span class="nav-wa-label">Empezar en WhatsApp</span>
        </a>
        <a href="/login" class="nav-cta">Entrar</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <nav class="solution-links" aria-label="Explora Tresqu">
          {solutionLinks.map(({ path: href, label }) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="footer-row">
          <p class="footer-brand">
            <img src="/3q.png" alt="" width="22" height="22" />
            <span>© {new Date().getFullYear()} Tresqu · Finanzas e inversiones por chat.</span>
          </p>
          <nav aria-label="Enlaces legales">
            <a href="https://tresqu.com/">tresqu.com</a>
            <a href="/funciones">Funciones</a>
            <a href="/privacy-policy">Privacidad</a>
            <a href="/sobre-tresqu/">Sobre Tresqu</a>
            <a href="mailto:contacto@tresqu.com">Contacto</a>
            <a href="/legal-notice">Aviso legal</a>
          </nav>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Tresqu · estilo «Noche de puntos» (landing-lab/u21) para las páginas estáticas */
  :root {
    --bg: #010208;
    --bg-2: #05060c;
    --ink: #dde4ff;
    --fg: #eef1ff;
    --text: #c9cee0;
    --muted: #8d93aa;
    --dim: #5b6076;
    --line: rgba(160, 170, 220, 0.12);
    --card: rgba(255, 255, 255, 0.03);
    --card-solid: #090a13;
    --border: rgba(255, 255, 255, 0.08);
    --accent: #00ff7f;
    --green: #00ff7f;
    --teal: #19d3c5;
    --violet: #6b5bff;
    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-display: var(--font-sans);
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color-scheme: dark;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html { -webkit-text-size-adjust: 100%; }

  body {
    position: relative;
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  img, svg { max-width: 100%; }

  /* ---------- Campo de puntos ---------- */
  .dot-field {
    position: absolute;
    inset: 0 0 auto;
    height: 760px;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent);
            mask-image: linear-gradient(to bottom, #000 45%, transparent);
  }

  .dots {
    position: absolute;
    inset: -10% -10%;
    background-size: 7px 7px;
  }

  /* capa tenue: manchas amplias de índigo profundo */
  .dots-dim {
    background-image: radial-gradient(circle, rgba(52, 58, 205, 0.55) 0.95px, transparent 1.25px);
    -webkit-mask-image:
      radial-gradient(38% 46% at 12% 22%, #000 0%, transparent 70%),
      radial-gradient(30% 40% at 88% 14%, #000 0%, transparent 72%),
      radial-gradient(34% 36% at 78% 62%, rgba(0, 0, 0, 0.8) 0%, transparent 70%),
      radial-gradient(26% 30% at 30% 70%, rgba(0, 0, 0, 0.6) 0%, transparent 70%);
            mask-image:
      radial-gradient(38% 46% at 12% 22%, #000 0%, transparent 70%),
      radial-gradient(30% 40% at 88% 14%, #000 0%, transparent 72%),
      radial-gradient(34% 36% at 78% 62%, rgba(0, 0, 0, 0.8) 0%, transparent 70%),
      radial-gradient(26% 30% at 30% 70%, rgba(0, 0, 0, 0.6) 0%, transparent 70%);
    animation: drift 38s ease-in-out infinite alternate;
  }

  /* capa brillante: núcleos de azul eléctrico */
  .dots-bright {
    background-image: radial-gradient(circle, rgba(92, 104, 255, 0.95) 1px, transparent 1.35px);
    -webkit-mask-image:
      radial-gradient(18% 22% at 14% 20%, rgba(0, 0, 0, 0.85) 0%, transparent 70%),
      radial-gradient(14% 20% at 86% 12%, rgba(0, 0, 0, 0.75) 0%, transparent 70%),
      radial-gradient(16% 16% at 80% 58%, rgba(0, 0, 0, 0.5) 0%, transparent 70%);
            mask-image:
      radial-gradient(18% 22% at 14% 20%, rgba(0, 0, 0, 0.85) 0%, transparent 70%),
      radial-gradient(14% 20% at 86% 12%, rgba(0, 0, 0, 0.75) 0%, transparent 70%),
      radial-gradient(16% 16% at 80% 58%, rgba(0, 0, 0, 0.5) 0%, transparent 70%);
    animation: drift 30s ease-in-out infinite alternate-reverse;
  }

  @keyframes drift {
    from { transform: translate3d(-1.5%, -1%, 0); }
    to { transform: translate3d(1.5%, 1.5%, 0); }
  }

  /* ---------- Nav en píldora ---------- */
  .site-header {
    position: sticky;
    top: 14px;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 18px 16px 0;
    pointer-events: none;
  }

  .pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 4px;
    max-width: 100%;
    padding: 6px 6px 6px 14px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 999px;
    background: rgba(8, 9, 16, 0.9);
    -webkit-backdrop-filter: blur(14px);
            backdrop-filter: blur(14px);
    line-height: 1.2;
  }

  .pill a { text-decoration: none; }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-right: 10px;
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
  }

  .brand img { display: block; border-radius: 6px; }

  .nav-link {
    padding: 8px 12px;
    border-radius: 999px;
    color: #b8bdd0;
    font-size: 14px;
    transition: color 0.2s;
  }

  .nav-link:hover, .nav-link[aria-current='page'] { color: #fff; }

  .nav-wa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: 6px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--green);
    color: #000;
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.2s;
  }

  .nav-wa svg { width: 16px; height: 16px; fill: #000; flex: none; }
  .nav-wa:hover { background: #3dff9b; }

  .nav-cta {
    position: relative;
    isolation: isolate;
    margin-left: 6px;
    padding: 8px 18px;
    border-radius: 999px;
    background: #0b0c14;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
  }

  /* borde degradado verde → índigo, como la píldora «Entrar» de la landing */
  .nav-cta::before, .btn-ghost::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    padding: 1.5px;
    border-radius: inherit;
    background: linear-gradient(100deg, var(--green), var(--teal) 45%, var(--violet));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
  }

  /* ---------- Botones ---------- */
  .btn, .btn-ghost {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 26px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s;
  }

  .btn { background: var(--green); color: #000; }
  .btn:hover { transform: translateY(-2px); background: #3dff9b; }
  .btn-ghost { background: rgba(10, 11, 20, 0.85); color: #fff; }
  .btn-ghost:hover { transform: translateY(-2px); background: #12141f; }

  /* ---------- Contenido ---------- */
  main {
    position: relative;
    z-index: 1;
    max-width: 752px;
    margin: 0 auto;
    padding: 72px 16px 96px;
  }

  h1, h2, h3, h4 {
    color: var(--ink);
    font-family: var(--font-display);
    letter-spacing: -0.025em;
  }

  h1 {
    margin: 18px 0 20px;
    font-weight: 300;
    font-size: clamp(36px, 5.2vw, 60px);
    line-height: 1.1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  /* segunda parte del titular en verde, como la landing */
  .accent { color: var(--green); font-weight: 400; }

  h2 {
    margin: 2.4em 0 0.6em;
    font-weight: 400;
    font-size: clamp(26px, 3vw, 32px);
    line-height: 1.2;
    text-wrap: balance;
  }

  h3 {
    margin: 1.8em 0 0.4em;
    font-weight: 500;
    font-size: 20px;
    line-height: 1.3;
  }

  p, li, dd { color: var(--text); }
  p { margin: 0 0 1.15em; }
  strong, b { color: #fff; font-weight: 600; }

  a { color: var(--green); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  a:hover { color: #6dffb4; }

  ul, ol { padding-left: 1.3em; margin: 0 0 1.4em; }
  li { margin: 0.45em 0; padding-left: 0.2em; }
  li::marker { color: var(--green); }
  ol li::marker { font-weight: 600; font-size: 0.9em; }

  dl { margin: 1.4em 0; border-top: 1px solid var(--line); }
  dt { margin: 0; padding-top: 16px; color: #fff; }
  dd { margin: 4px 0 0; padding-bottom: 16px; border-bottom: 1px solid var(--line); }

  table {
    width: 100%;
    margin: 1.8em 0;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--card);
    font-size: 15px;
    line-height: 1.55;
  }

  th, td {
    padding: 14px 16px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }

  tbody tr:last-child td { border-bottom: 0; }
  td + td, th + th { border-left: 1px solid var(--line); }

  th {
    background: rgba(255, 255, 255, 0.035);
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  td { color: var(--text); }

  code {
    padding: 2px 7px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    color: #e6eaff;
    font-family: var(--font-mono);
    font-size: 0.86em;
  }

  pre {
    margin: 1.6em 0;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--card-solid);
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.6;
  }

  pre code { padding: 0; border: 0; background: none; }

  blockquote {
    margin: 1.8em 0;
    padding: 18px 22px;
    border: 1px solid rgba(0, 255, 127, 0.18);
    border-radius: 14px;
    background: radial-gradient(120% 120% at 0% 0%, rgba(0, 255, 127, 0.08), transparent 60%), var(--card);
  }

  blockquote p:last-child { margin-bottom: 0; }

  hr { margin: 3em 0; border: none; border-top: 1px solid var(--line); }

  /* ruta de navegación (breadcrumbs) */
  .breadcrumbs {
    color: var(--muted);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .breadcrumbs a { color: var(--muted); text-decoration: none; }
  .breadcrumbs a:hover { color: #fff; }

  .byline { color: var(--muted); font-size: 14px; }
  .byline a { color: #cfd5ea; }

  .eyebrow {
    margin: 0;
    color: var(--green);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* preguntas frecuentes */
  details {
    margin: 10px 0;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--card);
    transition: border-color 0.2s;
  }

  details[open] { border-color: rgba(0, 255, 127, 0.25); }

  summary {
    position: relative;
    padding: 16px 52px 16px 20px;
    color: #fff;
    font-weight: 500;
    line-height: 1.45;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker { display: none; }

  summary::after {
    content: '+';
    position: absolute;
    top: 50%;
    right: 20px;
    translate: 0 -50%;
    color: var(--green);
    font-size: 22px;
    font-weight: 300;
    transition: rotate 0.2s;
  }

  details[open] summary::after { rotate: 45deg; }
  details > p { margin: 0; padding: 0 20px 18px; color: var(--muted); }

  a:focus-visible, summary:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; border-radius: 6px; }
  .nav-wa:focus-visible, .nav-cta:focus-visible, .btn:focus-visible, .btn-ghost:focus-visible { border-radius: 999px; }

  /* ---------- Pie ---------- */
  .site-footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
  }

  .footer-inner {
    width: min(1100px, 100% - 32px);
    margin-inline: auto;
    padding: 36px 0 40px;
  }

  .site-footer a { color: var(--muted); text-decoration: none; }
  .site-footer a:hover, .site-footer a[aria-current='page'] { color: #fff; }

  .solution-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-bottom: 28px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }

  .solution-links a {
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: #b8bdd0;
    font-size: 13.5px;
    line-height: 1.3;
    transition: border-color 0.2s, color 0.2s;
  }

  .solution-links a:hover, .solution-links a[aria-current='page'] { border-color: rgba(0, 255, 127, 0.4); color: #fff; }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
  }

  .footer-brand { display: flex; align-items: center; gap: 10px; margin: 0; color: var(--muted); }
  .footer-brand img { flex: none; border-radius: 6px; }
  .footer-row nav { display: flex; flex-wrap: wrap; gap: 8px 18px; }

  /* ---------- Responsive ---------- */
  @media (max-width: 640px) {
    body { font-size: 16.5px; }
    .site-header { top: 10px; padding-top: 12px; }
    .pill { padding-left: 10px; gap: 0; }
    .brand { margin-right: 4px; font-size: 14px; }
    .nav-link { padding: 8px 8px; font-size: 13.5px; }
    .nav-wa { padding: 9px; margin-left: 4px; }
    .nav-wa-label {
      position: absolute; width: 1px; height: 1px; overflow: hidden;
      clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
    }
    .nav-cta { padding: 8px 14px; margin-left: 4px; font-size: 13.5px; }
    main { padding-top: 48px; }
    .dot-field { height: 560px; opacity: 0.7; }
    .dots { background-size: 5px 5px; }
    table { display: block; overflow-x: auto; font-size: 14px; }
    th, td { padding: 12px 10px; }
    th { font-size: 11px; letter-spacing: 0.08em; }
    td:first-child, th:first-child { padding-left: 14px; }
    .footer-row { flex-direction: column; align-items: flex-start; }
  }

  @media (max-width: 360px) {
    .brand span { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dots { animation: none; }
    .btn, .btn-ghost, summary::after { transition: none; }
  }
</style>
