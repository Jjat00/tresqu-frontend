{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "heading": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 170
    },
    "intro": {
      "type": "string"
    },
    "updatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "faqs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "a": {
            "type": "string"
          }
        },
        "required": [
          "q",
          "a"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "heading",
    "description",
    "intro",
    "updatedDate",
    "faqs"
  ]
}